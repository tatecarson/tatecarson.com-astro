---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { needsUnicodeFallback } from '../lib/text';
import { talks, workshops, demos, mentoring } from '../data/research';

const works = (await getCollection('works')).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);

const [about, publications, teaching] = await Promise.all(
  ['about', 'publications', 'teaching'].map((s) => getEntry('pages', s)),
);
const About = (await render(about!)).Content;
const Publications = (await render(publications!)).Content;
const Teaching = (await render(teaching!)).Content;

// The hover panel is driven client-side from this, rather than from the DOM, so
// the markup stays a plain list of links that works with JS off.
const panelData = works.map((w) => ({
  id: w.id,
  title: w.data.title,
  year: w.data.yearLabel ?? String(w.data.year),
  blurb: w.data.blurb,
  medium: w.data.medium,
  tag: w.data.tag,
  thumbnail: w.data.thumbnail ?? null,
  uni: needsUnicodeFallback(w.data.title),
  status: w.data.status ?? '',
  research: (w.data.research ?? []).map((r) => `${r.kind} — ${r.detail}`),
}));

const span = `${works.at(-1)!.data.year} – ${works[0].data.year}`;

// The panel opens on the newest work. Rendering its media state server-side
// keeps the box from flashing before the client script runs, and leaves the
// panel correct with JS disabled.
const first = panelData[0];

const nav = [
  { n: '01', label: 'Works', href: '#works' },
  { n: '02', label: 'About', href: '#about' },
  { n: '03', label: 'Research', href: '#research' },
  { n: '04', label: 'Teaching', href: '#teaching' },
];

// Talks, workshops and demos share a shape and a presentation; only the
// subheading differs. Demos folds in with workshops rather than getting its own
// heading for one entry.
const appearances = [
  { label: 'Talks', items: talks },
  { label: 'Workshops & demos', items: [...workshops, ...demos] },
];

const connect = [
  { label: 'Email', href: 'mailto:tatecarson@pm.me' },
  { label: 'Github', href: 'https://github.com/tatecarson' },
  { label: 'Scholar', href: 'https://scholar.google.com/citations?user=XXFcT98AAAAJ&hl=en' },
  // The page is itself a CV, so there is no CV section — the download lives in
  // the sticky rail instead, reachable from anywhere rather than only at the
  // bottom of a very long page.
  { label: 'CV (PDF) ↗', href: '/carson-cv.pdf', accent: true },
];
---

<Base title="Tate Carson">
  <div class="ledger">
    {/* The rail is the page header, not a nav landmark: it opens with the h1
        and happens to contain the section links. Wrapping the whole thing in
        <nav> buried the page's only h1 inside a navigation landmark. */}
    <header class="rail">
      <h1 class="rail__name"><a href="/">Tate Carson</a></h1>
      <p class="rail__role">Composer, researcher,<br />upright bassist</p>
      <nav class="rail__nav" aria-label="Sections">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="rail__num">{item.n}</span> {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="rail__connect">
        {
          connect.map((c) => (
            <li>
              <a href={c.href} class:list={[c.accent && 'rail__cv']}>
                {c.label}
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <main class="column">
      <div class="intro">
        <p>
          Tate Carson, PhD, is an Assistant Professor of Digital Sound Design at
          Dakota State University (DSU), where he has been teaching since 2021.
          His research and creative practice center on participatory mobile
          music, web audio, and locative media.
        </p>
      </div>

      <section id="works" class="section section--works">
        <header class="section__head">
          <h2 class="label">01 — Works</h2>
          <span class="label">{span} · {works.length} entries</span>
        </header>
        <ul class="works">
          {
            works.map((w) => (
              <li>
                <a class="work" href={`/works/${w.id}/`} data-work={w.id}>
                  <span
                    class:list={['work__year', w.data.status && 'work__year--wip']}
                    title={w.data.status}
                  >
                    {w.data.yearLabel ?? w.data.year}
                  </span>
                  <span
                    class:list={['work__title', needsUnicodeFallback(w.data.title) && 'uni']}
                  >
                    {w.data.title}
                  </span>
                  <span class="work__tag">{w.data.tag}</span>
                  {/* Desktop shows this in the hover panel; on touch there is no
                      hover, so the blurb has to live in the row itself. */}
                  <span class="work__blurb">{w.data.blurb}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="about" class="section">
        <h2 class="label">02 — About</h2>
        <div class="prose"><About /></div>
      </section>

      <section id="research" class="section">
        <h2 class="label">03 — Research</h2>
        <h3 class="sublabel">Publications</h3>
        <div class="prose prose--refs"><Publications /></div>

        {
          appearances.map(({ label, items }) => (
            <>
              <h3 class="sublabel">{label}</h3>
              <ul class="appearances">
                {items.map((a) => (
                  <li>
                    <span class="appearances__year">{a.year}</span>
                    <span>
                      <span class="appearances__title">{a.title}</span>
                      <span class="appearances__venue">
                        {a.venue} · {a.location}
                        {a.note && <span class="appearances__note"> — {a.note}</span>}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
            </>
          ))
        }
      </section>

      <section id="teaching" class="section section--last">
        <h2 class="label">04 — Teaching</h2>
        <div class="prose"><Teaching /></div>

        <h3 class="sublabel">Undergraduate research &amp; mentoring</h3>
        <ul class="appearances">
          {
            mentoring.map((m) => (
              <li>
                <span class="appearances__year">{m.years}</span>
                <span class="appearances__venue">{m.detail}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {/* No CV section: the page is a CV, so a section labelled "CV" inside it
          read as a category error, and its degree list duplicated the closing
          paragraph of About. The PDF download moved to the rail. */}
    </main>

    <aside class="preview" aria-hidden="true">
      <div class="preview__sticky">
        <div class="preview__media" data-media hidden={!first?.thumbnail}>
          {first?.thumbnail && <img src={first.thumbnail} alt="" decoding="async" />}
        </div>
        <div class="preview__meta">
          <span data-year></span>
          <span><span class="preview__wip" data-status></span><span data-tag></span></span>
        </div>
        <p class="preview__title" data-title></p>
        <p class="preview__blurb" data-blurb></p>
        <p class="preview__medium" data-medium></p>
        <ul class="preview__research" data-research hidden></ul>
      </div>
    </aside>
  </div>

  <script is:inline type="application/json" id="works-data" set:html={JSON.stringify(panelData)} />

  <script>
    const el = document.getElementById('works-data');
    if (el) {
      type Panel = {
        id: string;
        title: string;
        year: string;
        blurb: string;
        medium: string;
        tag: string;
        thumbnail: string | null;
        uni: boolean;
        status: string;
        research: string[];
      };
      const data: Panel[] = JSON.parse(el.textContent ?? '[]');
      const byId = new Map(data.map((d) => [d.id, d]));

      const media = document.querySelector<HTMLElement>('[data-media]')!;
      const slots = {
        year: document.querySelector<HTMLElement>('[data-year]')!,
        tag: document.querySelector<HTMLElement>('[data-tag]')!,
        status: document.querySelector<HTMLElement>('[data-status]')!,
        title: document.querySelector<HTMLElement>('[data-title]')!,
        blurb: document.querySelector<HTMLElement>('[data-blurb]')!,
        medium: document.querySelector<HTMLElement>('[data-medium]')!,
      };
      const research = document.querySelector<HTMLElement>('[data-research]')!;

      let current = '';
      function show(id: string) {
        const d = byId.get(id);
        if (!d || id === current) return;
        current = id;
        slots.year.textContent = d.year;
        slots.tag.textContent = d.tag;
        // Renders as "IN PROGRESS · INSTALLATION" when set, plain tag otherwise.
        slots.status.textContent = d.status ? `${d.status} · ` : '';
        slots.title.textContent = d.title;
        slots.title.classList.toggle('uni', d.uni);
        slots.blurb.textContent = d.blurb;
        slots.medium.textContent = d.medium;

        // Only 7 of the works produced research; the rest hide the list rather
        // than showing an empty heading.
        research.textContent = '';
        research.hidden = d.research.length === 0;
        for (const line of d.research) {
          const li = document.createElement('li');
          li.textContent = line;
          research.appendChild(li);
        }

        // Most of the catalogue is acousmatic — fixed media and performance
        // audio that has no image because none exists. Rather than draw an
        // empty frame for the majority case, the box collapses and the text
        // takes the space.
        if (d.thumbnail) {
          media.innerHTML = `<img src="${d.thumbnail}" alt="" loading="lazy" decoding="async">`;
          media.hidden = false;
        } else {
          media.innerHTML = '';
          media.hidden = true;
        }
      }

      for (const row of document.querySelectorAll<HTMLElement>('[data-work]')) {
        const id = row.dataset.work!;
        row.addEventListener('mouseenter', () => show(id));
        row.addEventListener('focus', () => show(id));
      }

      if (data.length) show(data[0].id);
    }
  </script>
</Base>

<style>
  .ledger {
    display: grid;
    grid-template-columns: 186px minmax(0, 1fr) 330px;
    max-width: 1180px;
    margin: 0 auto;
    border-inline: 1px solid var(--ink);
  }

  /* ---- rail ---- */
  .rail {
    position: sticky;
    top: 0;
    align-self: start;
    padding: 26px 18px;
    border-right: 1px solid var(--rule);
    font: 400 12px/2 var(--mono);
  }

  /* The page h1. Sized as a rail item rather than as a heading — the visible
     hierarchy is the 01–05 spine, not this. */
  .rail__name {
    margin: 0;
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .rail__role {
    margin: 6px 0 24px;
    font-size: 11px;
    line-height: 1.6;
    opacity: 0.5;
  }

  .rail__nav ul,
  .rail__connect {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .rail__connect {
    margin-top: 24px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 11px;
    opacity: 0.6;
  }

  .rail__num {
    opacity: 0.45;
  }

  /* The CV download is the one link in the rail people actively look for, so it
     carries the accent rather than sitting at the list's 0.6 opacity. */
  .rail__cv {
    color: var(--accent);
    opacity: 1;
  }

  .rail__nav a[aria-current='true'] {
    color: var(--accent);
  }

  /* ---- centre column ---- */
  .column {
    border-right: 1px solid var(--rule);
    min-width: 0;
  }

  .intro {
    padding: 30px 30px 26px;
    border-bottom: 1px solid var(--rule);
  }

  .intro p {
    margin: 0;
    font-size: 25px;
    line-height: 1.32;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .section {
    padding: 26px 30px 22px;
    border-bottom: 1px solid var(--rule);
  }

  .section--works {
    padding: 14px 0 0;
  }

  .section--last {
    border-bottom: 0;
  }

  .section__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0 30px 8px;
  }

  /* ---- works list ---- */
  .works {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work {
    display: grid;
    /* The tag column takes exactly the width of its own category name rather
       than a fixed 190px sized for the longest one ("Improvising Acoustic
       Ensemble", ~186px). Tags are right-aligned in the last column, so their
       right edge stays flush either way and nothing moves at full width — but
       per-row sizing decouples the widest title from the widest tag, which
       never occur in the same row. The worst row then needs 433px for title
       plus tag instead of 510px, and that difference is what lets the layout
       hold together below 1180px. */
    grid-template-columns: 62px minmax(0, 1fr) max-content;
    gap: 12px;
    align-items: baseline;
    padding: 9px 30px;
    border-bottom: 1px solid var(--rule-faint);
  }

  .work:hover,
  .work:focus-visible {
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    outline-offset: -2px;
  }

  .work__year {
    font: 400 11px/1.9 var(--mono);
    opacity: 0.5;
  }

  .work__title {
    font-size: 20px;
    /* Roomier than the rest of the list on purpose: one title (S̜w͚a̎r̍m̸) carries
       stacked combining diacritics that clip at a tighter line-height. */
    line-height: 1.35;
  }

  .work__tag {
    font: 400 10px/2.1 var(--mono);
    text-align: right;
    text-transform: uppercase;
    /* Eased from .07em: at .07 the longest category needs 195px, which leaves
       only 1px of slack in the row. */
    letter-spacing: 0.04em;
    opacity: 0.45;
  }

  .work__blurb {
    display: none;
  }

  /* Applied to any title carrying combining marks, in the row and in the panel. */
  .uni {
    font-family: var(--serif-unicode);
  }

  /* Unfinished work. The trailing en-dash in the year label ("2025–") already
     reads as ongoing; the accent just keeps it from looking like a typo. */
  .work__year--wip {
    color: var(--accent);
    opacity: 1;
  }

  .work:hover .work__year--wip,
  .work:focus-visible .work__year--wip {
    color: inherit;
  }

  .preview__wip {
    color: var(--accent);
  }

  /* Subheading inside a numbered section (Publications / Talks / …). Sits a
     step below .label so the 01–05 spine stays the dominant structure. */
  .sublabel {
    margin: 26px 0 10px;
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .sublabel:first-of-type {
    margin-top: 16px;
  }

  /* Talks, workshops, mentoring — year in the gutter, detail alongside. */
  .appearances {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .appearances li {
    display: grid;
    grid-template-columns: 66px minmax(0, 1fr);
    gap: 16px;
    padding: 9px 0;
    border-bottom: 1px dotted var(--rule);
  }

  .appearances__year {
    font: 400 11px/1.9 var(--mono);
    opacity: 0.5;
  }

  .appearances__title {
    display: block;
    font-size: 17px;
    line-height: 1.4;
  }

  .appearances__venue {
    display: block;
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.7;
  }

  .appearances__note {
    opacity: 0.75;
  }

  /* ---- prose ---- */
  .prose {
    font-size: 18px;
    line-height: 1.55;
  }

  /* Every heading inside a page body gets the same mono label treatment: the
     01–05 spine is the page's visible hierarchy, and a body heading is a marker
     within a section rather than a competing level. The depth still matters to
     the document outline — scripts/migrate.mjs pushes each body down to sit
     under the section heading above it, which is why these run h3–h5. */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4),
  .prose :global(h5) {
    font: 500 10px/1 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.5;
    margin: 26px 0 10px;
  }

  /* Was h1-specific, but the bodies no longer open on an h1 — about opens on an
     h3 and publications on an <hr>. Scoped to the direct child so it collapses
     the leading margin without reaching into list items and inline runs. */
  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin: 0 0 13px;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--rule);
  }

  .prose :global(a:hover) {
    text-decoration-color: currentColor;
  }

  .prose :global(ul) {
    margin: 0 0 13px;
    padding-left: 18px;
  }

  .prose :global(li) {
    margin-bottom: 4px;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 18px 0;
  }

  .prose--refs :global(li) {
    font-size: 17px;
    line-height: 1.5;
    padding-bottom: 7px;
    margin-bottom: 7px;
    border-bottom: 1px dotted var(--rule);
  }

  .prose--refs :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  /* ---- preview ---- */
  .preview__sticky {
    position: sticky;
    top: 0;
    padding: 26px 22px;
  }

  .preview__media {
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(23, 23, 15, 0.3);
  }

  .preview__media[hidden] {
    display: none;
  }

  .preview__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* With the media box collapsed the metadata line becomes the panel's first
     element and no longer needs clearance above it. */
  .preview__media[hidden] + .preview__meta {
    margin-top: 0;
  }

  .preview__meta {
    display: flex;
    justify-content: space-between;
    margin: 16px 0 8px;
    font: 400 10px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .preview__title {
    margin: 0 0 10px;
    font-size: 27px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .preview__blurb {
    margin: 0 0 14px;
    font-size: 17px;
    line-height: 1.45;
  }

  .preview__medium {
    margin: 0;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    font: 400 11px/1.6 var(--mono);
    opacity: 0.55;
  }

  /* Grant / prize / paper this work produced. Accent-coloured so it reads as a
     different kind of fact from the medium line above it. */
  .preview__research {
    list-style: none;
    margin: 10px 0 0;
    padding: 10px 0 0;
    border-top: 1px solid var(--rule);
  }

  .preview__research[hidden] {
    display: none;
  }

  .preview__research li {
    font: 400 11px/1.55 var(--mono);
    color: var(--accent);
    margin-bottom: 5px;
  }

  /* ---- medium ----
     Three columns need 1095px: 519px for the widest row (year, gaps, and the
     266px title / 167px tag pair that costs the most together), 60px of row
     padding, the 186px rail and the 330px preview. Below that the centre column
     is squeezed and long titles wrap — at 1024px, nine of the twenty-one rows
     broke to two lines and one to three.

     The preview is the column that gives. It is driven by hover, so it is
     already the least useful part of the layout on a smaller screen, and
     dropping it lets the rows keep their horizontal shape all the way down to
     the mobile stack. The ledger keeps a fixed measure instead of widening to
     fill, which would push the prose past a readable line length.

     The breakpoint is 1140 rather than 1095 because a classic (non-overlay)
     scrollbar takes another 17px off the viewport, and because a threshold
     sitting exactly on the measured minimum has no room for the font metrics
     to differ by a pixel. */
  @media (max-width: 1140px) {
    .ledger {
      grid-template-columns: 186px minmax(0, 1fr);
      max-width: 860px;
    }

    .preview {
      display: none;
    }

    /* Would otherwise draw a second line 1px inside the ledger's own border. */
    .column {
      border-right: 0;
    }
  }

  /* ---- narrow ----
     The preview panel is hover-driven, so it has nothing to say on a touch
     device. Below 900px it is removed outright and each row carries its own
     blurb instead. */
  @media (max-width: 900px) {
    .ledger {
      grid-template-columns: minmax(0, 1fr);
      border-inline: 0;
    }

    .preview {
      display: none;
    }

    .rail {
      position: static;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 4px 20px;
      align-items: start;
      border-right: 0;
      border-bottom: 1px solid var(--ink);
    }

    .rail__role {
      margin-bottom: 0;
    }

    .rail__nav {
      grid-column: 1 / -1;
      margin-top: 12px;
    }

    .rail__nav ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 16px;
    }

    .rail__connect {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 16px;
      margin-top: 10px;
    }

    .rail__num {
      display: none;
    }

    .column {
      border-right: 0;
    }

    .intro,
    .section {
      padding-inline: 20px;
    }

    .intro p {
      font-size: 21px;
    }

    .section__head {
      padding-inline: 20px;
    }

    /* The category names are far too long for a narrow gutter — at 82px,
       "Live Electroacoustic Music" wrapped to three lines. Instead the row
       stacks: year and category share a line, then title, then blurb, each
       with the full width available. */
    .work {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 10px;
      row-gap: 2px;
      padding: 12px 20px;
    }

    .work__year {
      grid-area: 1 / 1;
    }

    .work__tag {
      grid-area: 1 / 2;
      text-align: left;
      line-height: 1.9;
    }

    .work__title {
      grid-area: 2 / 1 / auto / -1;
    }

    .work__blurb {
      display: block;
      grid-area: 3 / 1 / auto / -1;
      font-size: 15px;
      line-height: 1.45;
      opacity: 0.65;
      margin-top: 2px;
    }

    /* Hover styling is meaningless on touch and leaves rows stuck inverted. */
    .work:hover {
      background: none;
      color: inherit;
    }
  }
</style>
